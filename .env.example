# ==============================================================================
# Agentic AI Data Analyst - Environment Configuration
# ==============================================================================

# PostgreSQL Connection Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_ai_analytics
DB_USER=postgres
DB_PASSWORD=postgres

# SQLAlchemy Connection URLs (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentic_ai_analytics
DATABASE_URL_READONLY=postgresql+psycopg://analyst_readonly:analyst_password123@localhost:5432/agentic_ai_analytics

# LLM Provider Configuration (OpenAI, Groq, Ollama, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_groq_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000

# Synthetic Data Generation Settings (Fixed seed for deterministic reproducibility)
RANDOM_SEED=42
NUM_CUSTOMERS=500
NUM_PRODUCTS=25
NUM_STORES=8
NUM_ORDERS=2200

# Safety & Execution Controls
QUERY_TIMEOUT_SECONDS=10
DEFAULT_ROW_LIMIT=100
MAX_ROW_LIMIT=1000
